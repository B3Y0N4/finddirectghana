# Supabase project URL and public anon key (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign user + admin session JWTs. Required — the app will
# throw at runtime if this is unset. Generate with: openssl rand -base64 32
JWT_SECRET=

# Admin panel login credentials (plain env-var comparison, no separate DB row)
ADMIN_EMAIL=
ADMIN_PASSWORD=
